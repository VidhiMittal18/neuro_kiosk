{
  "project": "DenseNet121 Pneumonia ANN-to-SNN Conversion",
  "source_repo": "luanacarolina/pneumonia-chest-xray-classifier",
  "source_checkpoint": "checkpoints/binary/densenet121.pt",
  "conversion_method": "None",
  "conversion_note": "Converted from a pretrained ANN using SpikingJelly FXConverter; this is not a natively trained SNN.",
  "models": {
    "ann_weights": "densenet121_pneumonia_ann_state_dict.pt",
    "snn_full_fx_graphmodule": "densenet121_pneumonia_snn.pt",
