    "to_tensor": true,
    "normalize_mean": [
      0.485,
      0.456,
      0.406
    ],
    "normalize_std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "runtime": {
    "python_tested": "3.11.9",
    "torch": "2.6.0+cpu",
    "torchvision": "0.21.0+cpu",
    "device_used_for_evaluation": "CPU",
    "spikingjelly": "2.0.0"
  },
  "source_model_scope": "Model card describes pediatric AP chest X-rays.",
