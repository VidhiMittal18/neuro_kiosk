    "best_converted_snn": {
      "model": "snn",
      "timesteps": 16
    }
  },
  "thresholds_selected_on_validation": {
    "ann": 0.9981153011322021,
    "snn": {
      "4": 0.9908550977706909,
      "8": 0.9987940788269043,
      "16": 0.9999173879623413
    }
  },
  "class_to_index": {
    "NORMAL": 0,
    "PNEUMONIA": 1
